<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/qw_widget_bg" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">

    <TextView android:id="@+id/qw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1" android:textColor="@color/qw_text_secondary" android:textSize="12sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical|start" android:orientation="horizontal">
        <TextView android:id="@+id/qw_next_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:textColor="@color/qw_text" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/qw_next_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:maxLines="1" android:textColor="@color/qw_accent" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>

    <Chronometer android:id="@+id/qw_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/qw_text" android:textSize="16sp" />

    <TextView android:id="@+id/qw_current" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/qw_text_secondary" android:textSize="12sp" />
</LinearLayout>
