<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/qw_widget_bg" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">

    <TextView android:id="@+id/qw_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:textColor="@color/qw_text_secondary" android:textSize="12sp" />

    <TextView android:id="@+id/qw_arabic" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="4" android:textAlignment="viewEnd" android:textDirection="rtl"
        android:textColor="@color/qw_text" android:textSize="20sp" />

    <TextView android:id="@+id/qw_translation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="4" android:textColor="@color/qw_text" android:textSize="14sp" />

    <TextView android:id="@+id/qw_reference" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:maxLines="1" android:textColor="@color/qw_accent" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
