<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/qw_widget_bg" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">

    <TextView android:id="@+id/qw_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:textColor="@color/qw_text_secondary" android:textSize="12sp" />

    <TextView android:id="@+id/qw_surah" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1" android:textColor="@color/qw_text" android:textSize="20sp" android:textStyle="bold" />

    <TextView android:id="@+id/qw_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:textColor="@color/qw_text_secondary" android:textSize="13sp" />

    <ProgressBar android:id="@+id/qw_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/qw_progress" />

    <TextView android:id="@+id/qw_percent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:maxLines="1" android:textColor="@color/qw_text_secondary" android:textSize="11sp" />

    <TextView android:id="@+id/qw_action" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="@drawable/qw_button_bg" android:paddingBottom="6dp" android:paddingEnd="14dp" android:paddingStart="14dp"
        android:paddingTop="6dp" android:textColor="@color/qw_accent_text" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
