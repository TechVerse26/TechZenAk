<?xml version="1.0" encoding="utf-8"?>
<!-- Updates are event driven (alarms at prayer times and midnight, changes pushed by the app): no periodic polling. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/qw_continue_description"
    android:initialLayout="@layout/qw_widget_continue"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="180dp"
    android:previewLayout="@layout/qw_widget_continue"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
