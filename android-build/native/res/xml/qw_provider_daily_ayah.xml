<?xml version="1.0" encoding="utf-8"?>
<!-- Updates are event driven (alarms at prayer times and midnight, changes pushed by the app): no periodic polling. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/qw_daily_ayah_description"
    android:initialLayout="@layout/qw_widget_daily_ayah"
    android:minHeight="180dp"
    android:minResizeHeight="70dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/qw_widget_daily_ayah"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="3"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
