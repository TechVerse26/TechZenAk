# ---------------------------------------------------------------------------------------------------------------------
# Environment variables of Quran Bangla. Copy to .env for local work; NEVER commit a real .env (it is in .gitignore).
# Real values go to Vercel (Project Settings > Environment Variables) and GitHub (Settings > Secrets and variables > Actions).
# ---------------------------------------------------------------------------------------------------------------------

# ===== Backend (Vercel serverless functions in api/) ==========================================================
# Firebase Admin credentials (the whole service account JSON, one line). Used by AI Tafsir and story moderation.
FIREBASE_SERVICE_ACCOUNT=
# Google Gemini key for the AI Tafsir answers.
GEMINI_API_KEY=
# Extra origins allowed to call the API from a browser / WebView, comma separated, exact origins only.
# The standalone Android app (https://localhost, http://localhost, capacitor://localhost) is always allowed.
CORS_ALLOWED_ORIGINS=

# ===== Android build (GitHub Actions: .github/workflows/build-apk.yml) =========================================
# Optional: the hosted backend + the host of the verified App Links. The app does NOT load this site.
SITE_URL=https://quranbangla.vercel.app
# The Kotlin overlay (home screen widgets, reminders, Room, bridge): all (default) | none
QR_NATIVE_MODULES=all
# Where scripts/web/build-web.mjs wrote the web bundle (default build/www)
WEB_BUNDLE_DIR=

# Signing (release builds only; GitHub Secrets - never commit the keystore): see docs/ANDROID_BUILD_BN.md
# ANDROID_KEYSTORE_BASE64=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
# google-services.json (Firebase config for push) as a secret: GOOGLE_SERVICES_JSON
